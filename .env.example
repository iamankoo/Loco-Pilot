# Copy this file to .env and fill in real values. Never commit .env.

# ---- Application ----
APP_ENV=development
API_HOST=0.0.0.0
API_PORT=8000

# ---- PostgreSQL ----
# Default port is 5433 (not 5432) to avoid clashing with a locally installed
# PostgreSQL instance, which is common on dev machines.
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_USER=locopilot
POSTGRES_PASSWORD=locopilot
POSTGRES_DB=locopilot

# ---- Redis ----
# Default port is 6380 (not 6379) to avoid clashing with another local Redis
# instance, which is common on dev machines.
REDIS_HOST=localhost
REDIS_PORT=6380
REDIS_DB=0
REDIS_PASSWORD=

# ---- LLM Provider ----
# LLM_PROVIDER selects the provider implementation: nvidia (default) | gemini | qwen.
LLM_PROVIDER=nvidia
# LLM_BASE_URL only applies to OpenAI-compatible providers (nvidia, qwen) —
# Gemini talks to Google's own endpoint and needs no base URL.
# NVIDIA NIM: https://integrate.api.nvidia.com/v1
# Qwen example: https://dashscope-intl.aliyuncs.com/compatible-mode/v1
LLM_BASE_URL=https://integrate.api.nvidia.com/v1
LLM_MODEL=nvidia/nemotron-3-ultra-550b-a55b
LLM_API_KEY=your-api-key-here
LLM_TEMPERATURE=0.2
# 180s: the default provider (NVIDIA Nemotron Ultra, 550B) measured 20-35s
# per response even for a trivial reply, before Developer's multi-turn
# tool-calling loop adds its own per-turn context growth on top.
LLM_REQUEST_TIMEOUT=180

# ---- Embedding Provider ----
# EMBEDDING_PROVIDER: hashing (default, free/local/deterministic, no API key
# needed) | openai_compatible (a real semantic model via any OpenAI-compatible
# embeddings endpoint).
EMBEDDING_PROVIDER=hashing
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_API_KEY=
# Fixed pgvector column width; if using openai_compatible with a different
# model, this is passed as the `dimensions` parameter so the schema stays
# consistent.
EMBEDDING_DIMENSION=384

# ---- Workspace storage ----
# Root directory for the default "LocoPilot Storage" workspace, used
# whenever an execution is created without an explicit project or
# workspace_path. Leave unset to use a platform-appropriate application-
# data directory instead (never a path inside the repo, never hardcoded).
LOCOPILOT_WORKSPACE_ROOT=

# ---- Agent execution ----
# Maximum Debugger->Developer->Tester retry cycles before an unresolved
# failure is routed straight to Reviewer instead of retrying forever.
MAX_DEBUG_RETRIES=2
# Maximum Reviewer->Developer->Tester->Reviewer cycles for a
# "changes_required" verdict before it terminates as an honest
# needs_review outcome instead of looping forever.
MAX_REVIEW_RETRIES=2
# Bounds on the LLM-driven tool-calling loop (Developer/Debugger): how many
# tool calls one agent turn may make, how many an entire execution may make
# in total, and a hard wall-clock cap (seconds) on the whole graph run.
MAX_TOOL_CALLS_PER_AGENT=12
MAX_TOTAL_TOOL_CALLS=60
MAX_EXECUTION_SECONDS=900
# Hard cap on total agent turns (LangGraph node visits) for one execution —
# the outer safety net beneath MAX_DEBUG_RETRIES.
MAX_AGENT_TURNS=50
# Character budget for RAG context handed to any single agent prompt.
MAX_CONTEXT_CHARS=12000

# ---- Workspace intelligence (Phase 2.2) ----
# Bounds on the Orchestrator's one-time repository structure scan.
WORKSPACE_SCAN_MAX_FILES=2000
WORKSPACE_SCAN_MAX_DEPTH=8

# ---- Logging ----
# LOG_LEVEL: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
# LOG_FORMAT: console (human-readable, dev) | json (structured, prod)
LOG_FORMAT=console

# ---- CORS ----
# Comma-separated list of allowed origins for local frontend development.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
