# Copy this file to .env and fill in real values. Never commit .env.

# ---- Application ----
APP_ENV=development
API_HOST=0.0.0.0
API_PORT=8000

# ---- PostgreSQL ----
# Default port is 5433 (not 5432) to avoid clashing with a locally installed
# PostgreSQL instance, which is common on dev machines.
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_USER=locopilot
POSTGRES_PASSWORD=locopilot
POSTGRES_DB=locopilot

# ---- Redis ----
# Default port is 6380 (not 6379) to avoid clashing with another local Redis
# instance, which is common on dev machines.
REDIS_HOST=localhost
REDIS_PORT=6380
REDIS_DB=0
REDIS_PASSWORD=

# ---- LLM Provider ----
# LLM_PROVIDER selects the provider implementation: nvidia (default) | gemini | qwen.
LLM_PROVIDER=nvidia
# LLM_BASE_URL only applies to OpenAI-compatible providers (nvidia, qwen) —
# Gemini talks to Google's own endpoint and needs no base URL.
# NVIDIA NIM: https://integrate.api.nvidia.com/v1
# Qwen example: https://dashscope-intl.aliyuncs.com/compatible-mode/v1
LLM_BASE_URL=https://integrate.api.nvidia.com/v1
# Fallback model for any role below left unset.
LLM_MODEL=nvidia/nemotron-3-nano-30b-a3b
LLM_API_KEY=your-api-key-here
LLM_TEMPERATURE=0.2
# 180s: some NVIDIA-hosted models (e.g. Nemotron Ultra 550B) measured
# 20-35s per response even for a trivial reply, before Developer's
# multi-turn tool-calling loop adds its own per-turn context growth.
LLM_REQUEST_TIMEOUT=180

# ---- Role-based model routing ----
# Same provider/account, different model per role — each overrides
# LLM_MODEL for that one role only. Leave any of these blank to fall back
# to LLM_MODEL for that role. Tester has no corresponding variable — it
# never calls an LLM at all (fully deterministic).
# NOTE: openai/gpt-oss-20b was tried for PLANNER_MODEL and, verified via
# real execution, unreliably drops required fields (steps/testing_strategy)
# from the multi-field Plan schema under the real Planner prompt (confirmed
# finish_reason=tool_calls, not truncation — a genuine structured-output
# reliability gap for that specific model+schema combination, not a token
# limit). nvidia/nemotron-3-nano-30b-a3b has been reliable for this exact
# schema across many real executions.
# openai/gpt-oss-20b/120b were tried for Planner/Developer/Debugger and,
# verified via real execution (not a benchmark — actual failures), have a
# genuine, reproducible structured-output reliability gap on this NVIDIA
# NIM endpoint: with_structured_output intermittently returns None or an
# invalid enum value even for a single-field schema (DeveloperPlan) and
# finish_reason=tool_calls (not truncation) — a real bug, not schema
# complexity. nvidia/nemotron-3-nano-30b-a3b has been reliable for all of
# Plan/DeveloperPlan/DebugResult across many real executions.
PLANNER_MODEL=nvidia/nemotron-3-nano-30b-a3b
DEVELOPER_MODEL=nvidia/nemotron-3-nano-30b-a3b
DEBUGGER_MODEL=nvidia/nemotron-3-nano-30b-a3b
# nvidia/nemotron-3.5-lightning-30b-a3b verified reliable (3/3) for
# ReviewResult (7 fields) — kept as the one role using a different model.
REVIEWER_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b

# ---- Vision provider (optional) ----
# Unset by default: no browser/UI visual-verification capability consumes
# this yet (see docs on runtime verification). Reuses LLM_API_KEY when
# VISION_API_KEY is left blank and VISION_BASE_URL matches LLM_BASE_URL.
VISION_MODEL=
VISION_BASE_URL=
VISION_API_KEY=

# ---- Image generation provider (optional) ----
# Unset by default: no text-to-image model exists on a typical NVIDIA NIM
# account. Set all four (a real image-generation API — e.g. Stability AI,
# an OpenAI-images-compatible endpoint, Replicate/fal.ai) to enable
# tools/image.py's GenerateImageTool; it reports "not configured" rather
# than fabricating an image while any of these are unset.
IMAGE_PROVIDER=
IMAGE_BASE_URL=
IMAGE_MODEL=
IMAGE_API_KEY=

# ---- Embedding Provider ----
# EMBEDDING_PROVIDER: hashing (free/local/deterministic, no API key needed,
# no real semantic understanding) | openai_compatible (a real semantic
# model via any OpenAI-compatible embeddings endpoint).
EMBEDDING_PROVIDER=openai_compatible
EMBEDDING_BASE_URL=https://integrate.api.nvidia.com/v1
EMBEDDING_MODEL=nvidia/nemotron-3-embed-1b
EMBEDDING_API_KEY=your-api-key-here
# Fixed pgvector column width (see database/migrations) — passed as the
# `dimensions` request parameter. nvidia/nemotron-3-embed-1b is natively
# 2048-dim and rejects a request to truncate to anything smaller, so this
# must stay 2048 while that model is configured; a provider that DOES
# support truncation (e.g. OpenAI's text-embedding-3-*) could use a
# smaller value, but the schema would need to match (see the
# d83bd4503108 migration for how the column itself was widened).
EMBEDDING_DIMENSION=2048

# ---- Workspace storage ----
# Root directory for the default "LocoPilot Storage" workspace, used
# whenever an execution is created without an explicit project or
# workspace_path. Leave unset to use a platform-appropriate application-
# data directory instead (never a path inside the repo, never hardcoded).
LOCOPILOT_WORKSPACE_ROOT=

# ---- Agent execution ----
# Maximum Debugger->Developer->Tester retry cycles before an unresolved
# failure is routed straight to Reviewer instead of retrying forever.
MAX_DEBUG_RETRIES=2
# Maximum Reviewer->Developer->Tester->Reviewer cycles for a
# "changes_required" verdict before it terminates as an honest
# needs_review outcome instead of looping forever.
MAX_REVIEW_RETRIES=2
# Bounds on the LLM-driven tool-calling loop (Developer/Debugger): how many
# tool calls one agent turn may make, how many an entire execution may make
# in total, and a hard wall-clock cap (seconds) on the whole graph run.
MAX_TOOL_CALLS_PER_AGENT=12
MAX_TOTAL_TOOL_CALLS=60
MAX_EXECUTION_SECONDS=900
# Hard cap on total agent turns (LangGraph node visits) for one execution —
# the outer safety net beneath MAX_DEBUG_RETRIES.
MAX_AGENT_TURNS=50
# Character budget for RAG context handed to any single agent prompt.
MAX_CONTEXT_CHARS=12000

# ---- Workspace intelligence (Phase 2.2) ----
# Bounds on the Orchestrator's one-time repository structure scan.
WORKSPACE_SCAN_MAX_FILES=2000
WORKSPACE_SCAN_MAX_DEPTH=8

# ---- Logging ----
# LOG_LEVEL: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
# LOG_FORMAT: console (human-readable, dev) | json (structured, prod)
LOG_FORMAT=console

# ---- CORS ----
# Comma-separated list of allowed origins for local frontend development.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
